{
  "name": "music-deck",
  "version": "1.0.0",
  "private": true,
  "description": "StreamDock plugin: Now playing con letras y visualizador. Apple Music + SMTC.",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "deploy": "tsc && node tools/deploy.js --restart",
