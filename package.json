    "test": "tsc -p tsconfig.test.json && node --test \".test-build/test/*.test.js\""
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.97",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
